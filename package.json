{
  "name": "peterhanania-portfolio",
  "author": "Peter Hanania",
  "version": "1.2.0",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterhanania/portfolio.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "is-ci || husky",
    "lint": "eslint . --fix",
    "format": "prettier -w .",
    "post-fix": "npm run lint && npm run format",
    "dev": "astro dev --root ./packages/frontend/",
    "start": "astro dev --root ./packages/frontend/",
    "build": "astro build --root ./packages/frontend/",
    "preview": "astro preview --root ./packages/frontend/",
    "astro": "astro",
    "deploy": "npm run build && netlify deploy --build --prod"
  },
  "resolutions": {
    "glob-parent": ">=6.0.2",
    "minimist": ">=1.2.6"
  },
  "dependencies": {
    "@astrojs/netlify": "^6.6.4",
    "@astrojs/preact": "^4.1.3",
    "@preact/compat": "^18.3.1",
    "@preact/signals": "^1.3.4",
    "@vite-pwa/astro": "^1.2.0",
    "astro": "^5.17.3",
    "astro-compress": "^2.3.9",
    "baffle": "^0.3.6",
    "canvas-confetti": "^1.9.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.16.0",
    "lottie-web": "^5.13.0",
    "preact": "^10.28.4",
    "react-lottie-player": "^2.1.0",
    "react-schemaorg": "2.0.0",
    "react-tippy": "^1.4.0",
    "react-use-lanyard": "^0.3.6",
    "tippy.js": "^6.3.7",
    "typescript": "^5.7.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@commitlint/cz-commitlint": "^20.4.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@swc/core": "^1.10.7",
    "@swc/register": "^0.1.10",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^22.13.1",
    "chalk": "^5.3.0",
    "commitizen": "^4.3.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "execa": "^9.5.2",
    "fs-extra": "^11.1.1",
    "globals": "^15.14.0",
    "globby": "^13.2.2",
    "husky": "^9.1.7",
    "inquirer": "^9.2.10",
    "is-ci": "^3.0.1",
    "jsdom": "^21.1.2",
    "lint-staged": "^16.2.7",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "prettier": "^3.8.1",
    "schema-dts": "^1.1.5",
    "svgo": "^3.3.2",
    "turbo": "^2.8.10",
    "typescript-eslint": "^8.56.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "yarn@3.5.0",
  "overrides": {
    "react": "npm:@preact/compat@latest",
    "react-dom": "npm:@preact/compat@latest"
  },
  "description": "A blazing-fast personal portfolio built with Astro + Preact. 100/100 Lighthouse, PWA, 5 themes, scroll-jacking, and full keyboard accessibility.",
  "keywords": [
    "portfolio",
    "personal-website",
    "portfolio-website",
    "developer-portfolio",
    "portfolio-template",
    "personal-portfolio-website",
    "astro",
    "astro-portfolio",
    "astro-template",
    "preact",
    "typescript",
    "framer-motion",
    "pwa",
    "progressive-web-app",
    "turborepo",
    "monorepo",
    "zustand",
    "animations",
    "dark-mode",
    "multi-theme",
    "discord-presence",
    "lanyard",
    "lighthouse-100",
    "web-performance",
    "scroll-snap",
    "accessible",
    "a11y",
    "open-source",
    "netlify",
    "workbox",
    "frontend",
    "web-development"
  ],
  "bugs": {
    "url": "https://github.com/peterhanania/portfolio/issues"
  },
  "homepage": "https://github.com/peterhanania/portfolio#readme"
}
