{
  "name": "peterhanania-portfolio",
  "author": "Peter Hanania",
  "version": "1.0.3",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterhanania/portfolio.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "postinstall": "is-ci || husky install",
    "lint": "eslint . --fix --ext .ts,.tsx",
    "format": "prettier -w .",
    "post-fix": "npm run lint && npm run format",
    "dev": "astro dev --root ./packages/frontend/",
    "start": "astro dev --root ./packages/frontend/",
    "build": "astro build --root ./packages/frontend/",
    "preview": "astro preview --root ./packages/frontend/",
    "astro": "astro",
    "deploy": "npm run build && netlify deploy --build --prod"
  },
  "resolutions": {
    "glob-parent": ">=6.0.2",
    "minimist": ">=1.2.6"
  },
  "dependencies": {
    "@astrojs/netlify": "^3.0.2",
    "@astrojs/preact": "2.2.1",
    "@preact/compat": "17.1.2",
    "@preact/signals": "^1.2.0",
    "@types/react-tooltip": "^4.2.4",
    "astro": "2.10.3",
    "astro-compress": "2.0.1",
    "astro-icon": "0.8.1",
    "astro-tooltips": "^0.6.2",
    "clsx": "1.2.1",
    "preact": "10.16.0",
    "react-schemaorg": "2.0.0",
    "react-tippy": "^1.4.0",
    "react-use-lanyard": "0.3.0",
    "solid-js": "^1.7.11",
    "svgo": "2.8.0",
    "tippy.js": "^6.3.7",
    "typescript": "^5.1.6",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.6.7",
    "@commitlint/config-conventional": "^17.6.7",
    "@commitlint/cz-commitlint": "^17.6.7",
    "@ianvs/prettier-plugin-sort-imports": "^3.7.2",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@swc/core": "^1.3.72",
    "@swc/register": "^0.1.10",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^14.0.0",
    "@types/eslint": "^8.44.1",
    "@types/fs-extra": "^11.0.1",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^18.17.1",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^4.0.3",
    "chalk": "^5.3.0",
    "commitizen": "^4.3.0",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-astro": "0.28.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "eslint-plugin-unused-imports": "^3.0.0",
    "execa": "^7.2.0",
    "fs-extra": "^11.1.1",
    "globby": "^13.2.2",
    "husky": "^8.0.3",
    "inquirer": "^9.2.10",
    "is-ci": "^3.0.1",
    "jsdom": "^21.1.2",
    "lint-staged": "^13.3.0",
    "lodash": "^4.17.21",
    "minimist": "^1.2.8",
    "prettier": "^2.8.8",
    "schema-dts": "1.1.2",
    "turbo": "^1.10.15",
    "vite-plugin-pwa": "0.14.7"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "packageManager": "yarn@3.5.0",
  "overrides": {
    "react": "npm:@preact/compat@latest",
    "react-dom": "npm:@preact/compat@latest"
  },
  "description": "Peter's official portfolio :)",
  "bugs": {
    "url": "https://github.com/peterhanania/portfolio/issues"
  },
  "homepage": "https://github.com/peterhanania/portfolio#readme"
}
