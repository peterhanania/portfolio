{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "build": {
      "dependsOn": ["lint", "^build"],
      "outputs": ["dist/**"]
    },
    "publish": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
